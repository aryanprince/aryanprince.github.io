---
import '@fontsource-variable/geist';
import '@fontsource/instrument-serif/400.css';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import arrowUp from '@phosphor-icons/core/assets/regular/arrow-up.svg?raw';
import '../styles/global.css';
import { site, work } from '../site';
const productStack = [
  ['TypeScript', 'typescript', false], ['React', 'react', false], ['Laravel', 'laravel', false],
  ['Expo', 'expo', false], ['Effect', 'effect', false], ['PHP', 'php', true],
  ['Next.js', 'nextjs', true], ['Astro', 'astro', true],
];
const systemsStack = [
  ['PostgreSQL', 'postgresql', false], ['Redis', 'redis', false], ['Azure', 'azure', false],
  ['Kubernetes', 'kubernetes', false], ['Terraform', 'terraform', false], ['Docker', 'docker', false],
  ['Sentry', 'sentry', true], ['Playwright', 'playwright', true],
];
const resumeHref = site.resumeUrl || `mailto:${site.email}?subject=Resume%20request`;
const resumeLabel = site.resumeUrl ? 'Resume' : 'Request resume';
const description = 'Aryan Prince is a CTO and founding engineer building web, mobile and AI products. Currently leading engineering at PortzApp.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <title>Aryan Prince | CTO & Founding Engineer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://aryanprince.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Aryan Prince | CTO & Founding Engineer" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://aryanprince.com/" />
    <meta property="og:image" content="https://aryanprince.com/og-portfolio.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Aryan Prince. CTO at PortzApp and founding engineer building web, mobile and AI products. TypeScript, React, Laravel, Expo and Azure." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://aryanprince.com/og-portfolio.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="header">
        <a class="monogram" href="/" aria-label="Aryan Prince home"><img class="signature" src="/signature.png" alt="" width="94" height="40" /></a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={`mailto:${site.email}`}>Say hello <span class="icon" aria-hidden="true" set:html={arrowUpRight} /></a>
        </nav>
      </header>
      <main id="main">
        <section class="intro" aria-labelledby="name">
          <h1 id="name">Aryan Prince.</h1>
          <p class="role">CTO & founding engineer.</p>
          <div class="intro-bottom">
            <p class="intro-copy">I build products and the systems behind them. Currently leading engineering at PortzApp, from product decisions to the code that ships.</p>
            <div class="profile-links">
              <a href={resumeHref} target="_blank" rel="noopener noreferrer">{resumeLabel}</a>
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </div>
          </div>
        </section>
        <section class="section work" id="work" aria-labelledby="work-title">
          <h2 id="work-title">Selected work</h2>
          <div class="section-content">
            {work.map((item) => (
              <article class="work-item">
                <div class="work-heading"><h3 class="company-name"><span class="company-mark"><img src={item.logo} alt="" width="28" height="28" loading="lazy" /></span>{item.company}</h3><span class="date">{item.date}</span></div>
                <p class="work-role">{item.role}</p>
                <p>{item.description}</p>
                {item.detail && <p class="detail">{item.detail}</p>}
                {item.stack && <p class="stack">{item.stack}</p>}
              </article>
            ))}
          </div>
        </section>
        <section class="section" aria-labelledby="practice-title">
          <h2 id="practice-title">In practice</h2>
          <div class="section-content practice">
            <p>I work across product, engineering and operations. I care about clear architecture, useful tests and knowing what happens after a release.</p>
            <dl>
              <div>
                <dt>Product engineering</dt>
                <dd class="tech-logos" aria-label="Product engineering technologies">
                  {productStack.map(([label, icon, secondary]) => (
                    <span class:list={['tech-item', { 'secondary-tech': secondary }]}><img src={`/logos/${icon}.svg`} width="18" height="18" alt="" loading="lazy" /><span>{label}</span></span>
                  ))}
                </dd>
              </div>
              <div>
                <dt>Systems &amp; delivery</dt>
                <dd class="tech-logos" aria-label="Systems and delivery technologies">
                  {systemsStack.map(([label, icon, secondary]) => (
                    <span class:list={['tech-item', { 'secondary-tech': secondary }]}><img src={`/logos/${icon}.svg`} width="18" height="18" alt="" loading="lazy" /><span>{label}</span></span>
                  ))}
                </dd>
                <dd>CI/CD, end-to-end testing and OpenTelemetry.</dd>
              </div>
              <div><dt>Applied AI</dt><dd>Tool-calling assistants for users. Coding-agent harnesses for review loops, security checks and dependency upgrades.</dd></div>
            </dl>
          </div>
        </section>
        <section class="section" aria-labelledby="side-title">
          <h2 id="side-title">Open source</h2>
          <div class="section-content side-projects">
            <article><h3><a target="_blank" rel="noopener noreferrer" href="https://github.com/aryanprince/skill-sync">Skill Sync <span class="icon" aria-hidden="true" set:html={arrowUpRight} /></a></h3><p>A macOS app that keeps agent skills and MCP settings in sync.</p></article>
            <article><h3><a target="_blank" rel="noopener noreferrer" href="https://github.com/aryanprince/svgl-react">svgl-react <span class="icon" aria-hidden="true" set:html={arrowUpRight} /></a></h3><p>A React library for adding SVG brand logos to your interface.</p></article>
            <article><h3><a target="_blank" rel="noopener noreferrer" href="https://github.com/aryanprince/create-docker-db">create-docker-db <span class="icon" aria-hidden="true" set:html={arrowUpRight} /></a></h3><p>A CLI that sets up local databases using Docker Compose.</p></article>
            <article><h3><a target="_blank" rel="noopener noreferrer" href="https://github.com/aryanprince/campus-hub">Campus Hub <span class="icon" aria-hidden="true" set:html={arrowUpRight} /></a></h3><p>University portals built as independent services in a Next.js monorepo.</p></article>
          </div>
        </section>
        <section class="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">Have something in mind?</h2>
          <a href={`mailto:${site.email}`}>{site.email} <span class="icon" aria-hidden="true" set:html={arrowUpRight} /></a>
        </section>
      </main>
      <footer><span>© {new Date().getFullYear()} Aryan Prince</span><a href="#main">Back to top <span class="icon" aria-hidden="true" set:html={arrowUp} /></a></footer>
    </div>
  </body>
</html>
