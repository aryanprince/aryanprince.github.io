---
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { site, work } from '../site';
const techStack = [
  ['TypeScript', 'typescript'], ['React', 'react'], ['Laravel', 'laravel'],
  ['Expo', 'expo'], ['PostgreSQL', 'postgresql'], ['Redis', 'redis'],
  ['Azure', 'azure'], ['Kubernetes', 'kubernetes'], ['Terraform', 'terraform'], ['Docker', 'docker'],
];
const resumeHref = site.resumeUrl || `mailto:${site.email}?subject=Resume%20request`;
const resumeLabel = site.resumeUrl ? 'Resume' : 'Request resume';
const description = 'Aryan Prince is a CTO and founding engineer building web, mobile and AI products. Currently leading engineering at PortzApp.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Aryan Prince | CTO & Founding Engineer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://aryanprince.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Aryan Prince | CTO & Founding Engineer" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://aryanprince.com/" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="header">
        <a class="monogram" href="/" aria-label="Aryan Prince home">ap.</a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href={site.github}>GitHub</a>
          <a href={`mailto:${site.email}`}>Say hello <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="main">
        <section class="intro" aria-labelledby="name">
          <h1 id="name">Aryan Prince.</h1>
          <p class="role">CTO & founding engineer.</p>
          <div class="intro-bottom">
            <p class="intro-copy">I build products and the systems behind them. Currently leading engineering at PortzApp, from product decisions to the code that ships.</p>
            <div class="profile-links">
              <a href={resumeHref}>{resumeLabel}</a>
              <a href={site.linkedin}>LinkedIn</a>
            </div>
          </div>
        </section>
        <section class="section work" id="work" aria-labelledby="work-title">
          <h2 id="work-title">Selected work</h2>
          <div class="section-content">
            {work.map((item) => (
              <article class="work-item">
                <div class="work-heading"><h3>{item.company}</h3><span class="date">{item.date}</span></div>
                <p class="work-role">{item.role}</p>
                <p>{item.description}</p>
                {item.detail && <p class="detail">{item.detail}</p>}
                {item.stack && <p class="stack">{item.stack}</p>}
              </article>
            ))}
          </div>
        </section>
        <section class="section" aria-labelledby="practice-title">
          <h2 id="practice-title">In practice</h2>
          <div class="section-content practice">
            <p>I work across product, engineering and operations. I care about clear architecture, useful tests and knowing what happens after a release.</p>
            <ul class="tech-logos" aria-label="Core technology stack">
              {techStack.map(([label, icon]) => (
                <li><img src={`/logos/${icon}.svg`} width="20" height="20" alt="" loading="lazy" decoding="async" /><span>{label}</span></li>
              ))}
            </ul>
            <dl>
              <div><dt>Product engineering</dt><dd>TypeScript, PHP, React, Laravel, Expo and Effect.</dd></div>
              <div><dt>Systems & delivery</dt><dd>PostgreSQL, Redis, Azure, Kubernetes and Terraform. CI/CD, end-to-end testing and OpenTelemetry.</dd></div>
              <div><dt>Applied AI</dt><dd>Tool-calling assistants for users. Custom coding-agent harnesses for review loops, performance and security checks, and dependency upgrades.</dd></div>
            </dl>
          </div>
        </section>
        <section class="section" aria-labelledby="side-title">
          <h2 id="side-title">Open source</h2>
          <div class="section-content side-projects">
            <article><h3><a href="https://github.com/aryanprince/skill-sync">Skill Sync <span aria-hidden="true">↗</span></a></h3><p>A macOS menu bar app to keep coding-agent skills and MCP configurations in sync.</p></article>
            <article><h3><a href="https://github.com/aryanprince/svgl-react">svgl-react <span aria-hidden="true">↗</span></a></h3><p>A React component library that brings SVG logos from SVGL into your interface.</p></article>
            <article><h3><a href="https://github.com/aryanprince/create-docker-db">create-docker-db <span aria-hidden="true">↗</span></a></h3><p>A CLI for setting up local databases with Docker Compose.</p></article>
            <article><h3><a href="https://github.com/aryanprince/campus-hub">Campus Hub <span aria-hidden="true">↗</span></a></h3><p>A university management project built around independently deployed services in a Next.js monorepo.</p></article>
          </div>
        </section>
        <section class="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">Have something in mind?</h2>
          <a href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
        </section>
      </main>
      <footer><span>© {new Date().getFullYear()} Aryan Prince</span><a href="#main">Back to top ↑</a></footer>
    </div>
  </body>
</html>
